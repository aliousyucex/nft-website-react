# Abstract Testnet Chain ID (decimal: 11124, hex: 0x2B74)
VITE_CHAIN_ID=0x2B74

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=4fa1d964ec5302ec1801f47c61b39b7d

