# Server Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Not in Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game

# JWT & Security
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
API_SECRET_KEY=your_api_secret_key_change_in_production

# Blockchain (Monad Testnet)
CONTRACT_ADDRESS=0x95F3e85e18B5e423AD44cF519629Ab87328Da63C
RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=f0017c5901ca17a6fd57696b67fda666f562030fcc47fc8dabf360cffff52154

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BAN_DURATION_MS=3600000

# WebSocket
SOCKET_PING_TIMEOUT=10000
SOCKET_PING_INTERVAL=25000

# Game Settings
CARD_SELECTION_TIMEOUT=10000
DISCONNECT_GRACE_PERIOD=10000
MAX_ROUND_LIMIT=15
COMMISSION_RATE=0.03

