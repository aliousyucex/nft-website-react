# Server Configuration
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Not in Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/iwf_game

# JWT & Security
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
API_SECRET_KEY=your_api_secret_key_change_in_production

# Blockchain (Abstract Chain)
CONTRACT_ADDRESS=0x...
RPC_URL=https://api.testnet.abs.xyz
PRIVATE_KEY=your_private_key_without_0x_prefix

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BAN_DURATION_MS=3600000

# WebSocket
SOCKET_PING_TIMEOUT=10000
SOCKET_PING_INTERVAL=25000

# Game Settings
CARD_SELECTION_TIMEOUT=5000
DISCONNECT_GRACE_PERIOD=10000
MAX_ROUND_LIMIT=15
COMMISSION_RATE=0.03

